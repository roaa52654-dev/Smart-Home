#include <SPI.h>
#include <MFRC522.h>
#include <Keypad.h>
#include <ESP32Servo.h>
#include <EEPROM.h>
#include <WiFi.h>
#include <WebServer.h>

// --- RFID ---
#define SS_PIN 21
#define RST_PIN 22
MFRC522 rfid(SS_PIN, RST_PIN);

// --- EEPROM ---
#define EEPROM_SIZE 64

// --- Keypad ---
const byte ROWS = 4;
const byte COLS = 4;
char keys[ROWS][COLS] = {
  {'1','2','3','A'},
  {'4','5','6','B'},
  {'7','8','9','C'},
  {'*','0','#','D'}
};
byte rowPins[ROWS] = {13, 12, 14, 27};
byte colPins[COLS] = {26, 25, 33, 32};
Keypad keypad = Keypad(makeKeymap(keys), rowPins, colPins, ROWS, COLS);

// --- Servo ---
Servo lockServo;

// --- LEDs ---
#define GREEN_LED 15
#define RED_LED 2

// --- Passwords ---
String correctPassword = "1234";
String masterPassword = "0000";
String enteredPassword = "";

// --- UID ---
String allowedUID = "";

// --- Wi-Fi Access Point ---
const char* ssid = "SmartLockNet";
const char* password = "12345678";
WebServer server(80);

// --- Unlock Door ---
void openLock() {
  digitalWrite(GREEN_LED, HIGH);
  digitalWrite(RED_LED, LOW);
  lockServo.write(90);
  Serial.println("تم الفتح!");
  delay(5000);
  lockServo.write(0);
  digitalWrite(GREEN_LED, LOW);
}

// --- EEPROM UID Functions ---
void saveUID(String uid) {
  for (int i = 0; i < uid.length(); i++) {
    EEPROM.write(i, uid[i]);
  }
  EEPROM.write(uid.length(), '\0');
  EEPROM.commit();
}

String loadUID() {
  String uid = "";
  for (int i = 0; i < 32; i++) {
    char c = EEPROM.read(i);
    if (c == '\0') break;
    uid += c;
  }
  return uid;
}

// --- Add New Card ---
void registerNewCard() {
  Serial.println("مرر الكارت الجديد...");
  while (!rfid.PICC_IsNewCardPresent() || !rfid.PICC_ReadCardSerial());

  String newUID = "";
  for (byte i = 0; i < rfid.uid.size; i++) {
    newUID += String(rfid.uid.uidByte[i], HEX);
    if (i < rfid.uid.size - 1) newUID += " ";
  }
  newUID.toUpperCase();
  saveUID(newUID);
  allowedUID = newUID;
  Serial.println("تم تسجيل الكارت الجديد: " + newUID);

  rfid.PICC_HaltA();
  rfid.PCD_StopCrypto1();
}

// --- WiFi Handlers ---
void handleRoot() {
  server.send(200, "text/html", "<h1>Welcome to The Smart Lock</h1><a href='/unlock'>Unlock Door</a>");
}

void handleUnlock() {
  openLock();
  server.send(200, "text/plain", "The Door has been Unlocked");
}

void setupWiFi() {
  WiFi.softAP(ssid, password);
  Serial.print("تم تشغيل الشبكة. IP: ");
  Serial.println(WiFi.softAPIP());

  server.on("/", handleRoot);
  server.on("/unlock", handleUnlock);
  server.begin();
}

void setup() {
  Serial.begin(115200);
  SPI.begin();
  rfid.PCD_Init();
  EEPROM.begin(EEPROM_SIZE);

  pinMode(GREEN_LED, OUTPUT);
  pinMode(RED_LED, OUTPUT);
  digitalWrite(GREEN_LED, LOW);
  digitalWrite(RED_LED, LOW);

  lockServo.attach(4); // D4
  lockServo.write(0);

  allowedUID = loadUID();
  Serial.println("UID المسجل: " + allowedUID);

  setupWiFi();
}

void loop() {
  // --- RFID ---
  if (rfid.PICC_IsNewCardPresent() && rfid.PICC_ReadCardSerial()) {
    String uidStr = "";
    for (byte i = 0; i < rfid.uid.size; i++) {
      uidStr += String(rfid.uid.uidByte[i], HEX);
      if (i < rfid.uid.size - 1) uidStr += " ";
    }
    uidStr.toUpperCase();
    Serial.println("UID مقروء: " + uidStr);

    if (uidStr == allowedUID) {
      openLock();
      digitalWrite(RED_LED, LOW);
    } else {
      Serial.println("كارت غير مسجل.");
      digitalWrite(RED_LED, HIGH);
      delay(2000);
      digitalWrite(RED_LED, LOW);
    }

    rfid.PICC_HaltA();
    rfid.PCD_StopCrypto1();
  }

  // --- Keypad ---
  char key = keypad.getKey();
  if (key) {
    if (key == '#') {
      if (enteredPassword == correctPassword) {
        openLock();
        digitalWrite(RED_LED, LOW);
      } else if (enteredPassword == masterPassword) {
        registerNewCard();
      } else {
        Serial.println("رقم سري خاطئ.");
        digitalWrite(RED_LED, HIGH);
        delay(2000);
        digitalWrite(RED_LED, LOW);
      }
      enteredPassword = "";
    } else if (key == '*') {
      enteredPassword = "";
    } else {
      enteredPassword += key;
    }
  }

  // --- Web Server ---
  server.handleClient();
}
